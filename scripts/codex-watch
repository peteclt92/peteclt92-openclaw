#!/usr/bin/env bash
set -euo pipefail

# codex-watch: run a codex command and notify via OpenClaw wake when it finishes.
#
# Usage:
#   codex-watch "<label>" -- codex exec ...
#
# Notes:
# - Notification is best-effort and does not affect the exit code.
# - Requires `openclaw` CLI available on PATH.

if [[ $# -lt 3 ]]; then
  echo "Usage: codex-watch \"<label>\" -- <command...>" >&2
  exit 2
fi

LABEL="$1"
shift

if [[ "$1" != "--" ]]; then
  echo "Expected -- after label" >&2
  echo "Usage: codex-watch \"<label>\" -- <command...>" >&2
  exit 2
fi
shift

if [[ $# -lt 1 ]]; then
  echo "Missing command" >&2
  exit 2
fi

START_EPOCH="$(date +%s)"
CWD="$(pwd)"
BRANCH=""
if command -v git >/dev/null 2>&1; then
  BRANCH="$(git branch --show-current 2>/dev/null || true)"
fi

LOG_DIR="${CWD}/.codex-watch"
mkdir -p "$LOG_DIR"
STAMP="$(date +%Y%m%d-%H%M%S)"
SAFE_LABEL="$(echo "$LABEL" | tr ' /' '__' | tr -cd '[:alnum:]_\-.' | cut -c1-80)"
LOG_PATH="${LOG_DIR}/${STAMP}-${SAFE_LABEL}.log"

send_wake() {
  local text="$1"
  local params_json=""
  if command -v python3 >/dev/null 2>&1; then
    params_json="$(python3 -c 'import json,sys; print(json.dumps({"text": sys.argv[1], "mode": "now"}))' "$text")"
  else
    # Fallback: extremely simple escape (best-effort)
    local escaped_msg="${text//\"/\\\"}"
    params_json="{\"text\":\"${escaped_msg}\",\"mode\":\"now\"}"
  fi

  (openclaw gateway call cron.wake --params "$params_json" >/dev/null 2>&1) || true
}

# Proactive start message (best-effort)
START_MSG="Codex started: ${LABEL} | cwd=${CWD}"
if [[ -n "$BRANCH" ]]; then
  START_MSG="${START_MSG} | branch=${BRANCH}"
fi
START_MSG="${START_MSG} | logbook=http://localhost:3010 | log=${LOG_PATH}"
send_wake "$START_MSG"

# Run the command, capture output to log and also stream to console.
set +e
"$@" 2>&1 | tee "$LOG_PATH"
EC=${PIPESTATUS[0]}
set -e

END_EPOCH="$(date +%s)"
DUR="$((END_EPOCH - START_EPOCH))"

MSG="Codex finished: ${LABEL} | exit=${EC} | dur=${DUR}s | cwd=${CWD}"
if [[ -n "$BRANCH" ]]; then
  MSG="${MSG} | branch=${BRANCH}"
fi
MSG="${MSG} | log=${LOG_PATH}"

# Best-effort wake (do not fail the wrapper if notification fails).
send_wake "$MSG"

exit "$EC"
